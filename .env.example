# Copiar a .env para desarrollo local (no se versiona).
# DATABASE_URL es obligatoria (PostgreSQL local, en Docker o RDS).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blacklist
JWT_SECRET_KEY=dev-secret-change-me
# Localmente no hay proxy delante de Flask
PROXY_COUNT=0
# New Relic APM
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=blacklist-api-dev
NEW_RELIC_MONITOR_MODE=true
NEW_RELIC_LOG=stdout
